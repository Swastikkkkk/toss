# toss has no secrets to configure and reads almost nothing from the environment.
#
# Your settings and your pairing code live in a readable file instead:
#   ~/.toss/config.json
# See it any time with:  toss status
#
# The only environment variable toss reads:

# Where that config file lives. Useful for keeping separate pairings,
# or for running a throwaway one that leaves nothing behind.
TOSS_HOME=~/.toss

# Everything else is a flag or a saved setting, not a secret:
#   toss serve --key capslock --hold 0.25
#   toss serve --new-code        rotate the pairing code
#   toss install                 start on login
